datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  PARTNER
  VET
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique
  name            String?
  role            UserRole       @default(CUSTOMER)
  firebaseUid     String?        @unique // For integration with Firebase Authentication
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  // Relations
  pets            Pet[]
  vets            Vet?
  appointments    Appointment[]  @relation("UserAppointments")
  orders          Order[]
  groomingBookings GroomingBooking[]
  boardingBookings BoardingBooking[]
  subscriptions   Subscription[]
  notifications   Notification[]

  @@index([email])
  @@index([firebaseUid])
}

model Pet {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  species         String
  breed           String?
  age             Int?
  ownerId         String         @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  owner           User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  groomingBookings GroomingBooking[]
  boardingBookings BoardingBooking[]

  @@index([ownerId])
}

model Vet {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @unique @db.Uuid
  specialty       String
  licenseNumber   String         @unique
  experienceYears Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@index([userId])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  customerId      String            @db.Uuid
  vetId           String            @db.Uuid
  petId           String            @db.Uuid
  dateTime        DateTime
  status          AppointmentStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  customer        User              @relation("UserAppointments", fields: [customerId], references: [id], onDelete: Cascade)
  vet             Vet               @relation(fields: [vetId], references: [id], onDelete: Cascade)
  pet             Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([vetId])
  @@index([petId])
  @@index([dateTime])
}

model Product {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  price           Decimal        @db.Decimal(10, 2)
  stockQuantity   Int            @default(0)
  sku             String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  orderItems      OrderItem[]

  @@index([sku])
}

model Order {
  id              String         @id @default(uuid()) @db.Uuid
  customerId      String         @db.Uuid
  status          OrderStatus    @default(PENDING)
  totalAmount     Decimal        @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  customer        User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id              String         @id @default(uuid()) @db.Uuid
  orderId         String         @db.Uuid
  productId       String         @db.Uuid
  quantity        Int
  price           Decimal        @db.Decimal(10, 2)

  // Relations
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model GroomingBooking {
  id              String         @id @default(uuid()) @db.Uuid
  customerId      String         @db.Uuid
  petId           String         @db.Uuid
  dateTime        DateTime
  status          BookingStatus  @default(PENDING)
  packageType     String
  price           Decimal        @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  customer        User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pet             Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([petId])
  @@index([dateTime])
}

model BoardingBooking {
  id              String         @id @default(uuid()) @db.Uuid
  customerId      String         @db.Uuid
  petId           String         @db.Uuid
  startDate       DateTime
  endDate         DateTime
  status          BookingStatus  @default(PENDING)
  notes           String?
  price           Decimal        @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  customer        User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pet             Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([petId])
  @@index([startDate, endDate])
}

model Subscription {
  id              String             @id @default(uuid()) @db.Uuid
  customerId      String             @db.Uuid
  name            String
  status          SubscriptionStatus @default(ACTIVE)
  price           Decimal            @db.Decimal(10, 2)
  interval        String             // e.g., monthly, yearly
  startDate       DateTime           @default(now())
  endDate         DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Relations
  customer        User               @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Notification {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  title           String
  message         String
  isRead          Boolean        @default(false)
  createdAt       DateTime       @default(now())

  // Relations
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AnalyticEvent {
  id              String         @id @default(uuid()) @db.Uuid
  eventType       String         // e.g., "PURCHASE", "BOOKING", "LOGIN"
  eventData       Json?
  createdAt       DateTime       @default(now())

  @@index([eventType])
  @@index([createdAt])
}
